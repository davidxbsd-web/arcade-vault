# Copia este archivo como .env.local y completa los valores.
# RESEND_*/CONTACT_* se usan solo en el servidor (Server Action de /acerca-de).
# NO llevan prefijo NEXT_PUBLIC_ y no deben exponerse al cliente.

#https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_FROM=onboarding@resend.dev
CONTACT_TO=

# Supabase — dashboard del proyecto > Project Settings > API
# La publishable key (sb_publishable_...) es pública y va al bundle del cliente; protegida por RLS.
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=https://fxjkniebncdtryidhcsl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
